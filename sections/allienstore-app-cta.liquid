<section class="section-allien">
  <div class="section-inner-allien">
    <div class="app-cta-allien">
      <div>
        <div class="app-cta-label-allien">{{ section.settings.label }}</div>
        <h2>{{ section.settings.title }}</h2>
        <p class="app-cta-sub-allien">{{ section.settings.subtitle }}</p>
        <div class="app-btns-allien">
          <a href="{{ section.settings.apple_url }}" class="app-store-btn-allien">
            <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.1 2.48-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.31-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.24-1.99 1.1-3.15-1.04.04-2.3.69-3.05 1.56-.67.77-1.26 1.97-1.1 3.1 1.16.09 2.31-.68 3.05-1.51z"/></svg>
            <div>
              <div class="asb-small-allien">Download on the</div>
              <div class="asb-name-allien">App Store</div>
            </div>
          </a>
          <a href="{{ section.settings.google_url }}" class="app-store-btn-allien">
            <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M3 20.5v-17l14.5 8.5L3 20.5zM5 18l10.5-6L5 6v12z"/></svg>
            <div>
              <div class="asb-small-allien">Get it on</div>
              <div class="asb-name-allien">Google Play</div>
            </div>
          </a>
        </div>
      </div>
      <div class="app-mockup-allien">
        {%- for block in section.blocks -%}
          <div class="app-mock-item-allien">
            <div class="ami-dot-allien"></div>
            <div class="ami-text-allien">{{ block.settings.text }}</div>
            <div class="ami-val-allien">{{ block.settings.value }}</div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Allien App CTA",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Mobile App"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Shop on the Go with AllienStore App"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Never miss a deal again. Get instant notifications, track cashback in real-time, and withdraw earnings with one tap."
    },
    {
      "type": "url",
      "id": "apple_url",
      "label": "App Store URL"
    },
    {
      "type": "url",
      "id": "google_url",
      "label": "Google Play URL"
    }
  ],
  "blocks": [
    {
      "type": "mockup_item",
      "name": "Mockup Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Value"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Allien App CTA",
      "blocks": [
        { "type": "mockup_item", "settings": { "text": "Amazon Cashback", "value": "₹450" } },
        { "type": "mockup_item", "settings": { "text": "Myntra Reward", "value": "₹120" } },
        { "type": "mockup_item", "settings": { "text": "Wallet Balance", "value": "₹2,840" } }
      ]
    }
  ]
}
{% endschema %}
