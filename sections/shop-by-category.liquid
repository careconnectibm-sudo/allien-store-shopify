{% comment %}
  ═══════════════════════════════════════════════════════════════
  Section: Shop by Category (Premium)
  File:    sections/shop-by-category.liquid
  Requires: assets/stores-data.js
  ═══════════════════════════════════════════════════════════════
  A responsive category grid using Shopify collection images as background covers.
{% endcomment %}

<script src="{{ 'stores-data.js' | asset_url }}" defer="defer"></script>

<section
  id="sbc-{{ section.id }}"
  class="sbc-section"
  style="
    --sbc-bg: {{ section.settings.bg_color }};
    --sbc-text: {{ section.settings.text_color }};
    --sbc-accent: {{ section.settings.accent_color }};
    padding-top: {{ section.settings.pad_top }}px;
    padding-bottom: {{ section.settings.pad_bot }}px;
  "
>
  <div class="sbc-container">
    {%- if section.settings.heading != blank -%}
      <div class="sbc-header">
        <h2 class="sbc-heading">{{ section.settings.heading }}</h2>
        {%- if section.settings.subheading != blank -%}
          <p class="sbc-subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="sbc-grid" id="sbc-grid-{{ section.id }}">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- assign collection = block.settings.collection -%}
          {%- if collection != blank -%}
            <a href="{{ collection.url }}" class="sbc-card sbc-card--manual" {{ block.shopify_attributes }}>
              <div class="sbc-image-wrapper">
                {%- if collection.featured_image != blank -%}
                  <img src="{{ collection.featured_image | img_url: '400x400', crop: 'center' }}" 
                       alt="{{ collection.title | escape }}"
                       loading="lazy"
                       class="sbc-image">
                {%- else -%}
                  {{ 'collection-1' | placeholder_svg_tag: 'sbc-image sbc-placeholder' }}
                {%- endif -%}
                <div class="sbc-overlay"></div>
              </div>
              <div class="sbc-content">
                <span class="sbc-title">{{ collection.title }}</span>
                {%- if section.settings.show_counts -%}
                   <span class="sbc-count" data-category="{{ collection.title }}">0 Stores</span>
                {%- endif -%}
              </div>
            </a>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        <!-- Categories injected via JS if no blocks -->
      {%- endif -%}
    </div>
  </div>
</section>

<style>
.sbc-section {
  background: var(--sbc-bg, #ffffff);
  color: var(--sbc-text, #1a1a1a);
  overflow: hidden;
}
.sbc-container {
  max-width: 1400px;
  margin: 0 auto;
  padding: 0 20px;
}
.sbc-header {
  text-align: left;
  margin-bottom: 40px;
}
.sbc-heading {
  font-size: clamp(1.75rem, 5vw, 2.5rem);
  font-weight: 800;
  margin: 0 0 10px;
  letter-spacing: -0.02em;
}
.sbc-subheading {
  font-size: 1.1rem;
  color: #666;
  max-width: 600px;
  margin: 0;
  line-height: 1.5;
}

.sbc-grid {
  display: flex;
  gap: 20px;
  overflow-x: auto;
  padding: 10px 0 30px;
  scrollbar-width: none;
  -ms-overflow-style: none;
  scroll-snap-type: x mandatory;
}
.sbc-grid::-webkit-scrollbar {
  display: none;
}

.sbc-card {
  flex: 0 0 auto;
  width: 160px;
  display: flex;
  flex-direction: column;
  text-decoration: none;
  color: inherit;
  transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
  scroll-snap-align: start;
}

.sbc-image-wrapper {
  position: relative;
  width: 100%;
  aspect-ratio: 1 / 1;
  border-radius: 24px;
  overflow: hidden;
  margin-bottom: 16px;
  box-shadow: 0 10px 30px rgba(0,0,0,0.1);
  background: #f5f5f5;
  transition: all 0.4s ease;
}

.sbc-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.6s cubic-bezier(0.165, 0.84, 0.44, 1);
}

.sbc-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(to bottom, transparent 0%, rgba(0,0,0,0.05) 100%);
  opacity: 0;
  transition: opacity 0.4s ease;
}

.sbc-card:hover .sbc-image-wrapper {
  transform: translateY(-8px);
  box-shadow: 0 20px 40px rgba(0,0,0,0.15);
}

.sbc-card:hover .sbc-image {
  transform: scale(1.1);
}

.sbc-card:hover .sbc-overlay {
  opacity: 1;
}

.sbc-content {
  text-align: center;
}

.sbc-title {
  display: block;
  font-size: 1rem;
  font-weight: 700;
  margin-bottom: 4px;
  transition: color 0.3s ease;
}

.sbc-count {
  font-size: 0.8rem;
  color: #888;
  font-weight: 500;
}

.sbc-card:hover .sbc-title {
  color: var(--sbc-accent);
}

@media (min-width: 990px) {
  .sbc-grid {
    flex-wrap: wrap;
    justify-content: flex-start;
    overflow-x: visible;
    gap: 30px;
  }
  .sbc-card {
    width: calc(16.666% - 25px);
  }
}

@media (max-width: 768px) {
  .sbc-card {
    width: 140px;
  }
}
</style>

{%- capture collection_images_json -%}
{
  {%- for collection in collections -%}
    "{{ collection.title | escape }}": "{{ collection.featured_image | img_url: '400x400', crop: 'center' }}"{%- unless forloop.last -%},{%- endunless -%}
  {%- endfor -%}
}
{%- endcapture -%}

<script>
(function() {
  const SEC_ID = '{{ section.id }}';
  const SHOW_COUNTS = {{ section.settings.show_counts | json }};
  const COLLECTION_IMAGES = {{ collection_images_json }};
  
  // High-quality fallbacks if no matching Shopify collection is found
  const FALLBACK_IMAGES = {
    'Fashion': 'https://images.unsplash.com/photo-1445205170230-053b83016050?auto=format&fit=crop&w=400&q=80',
    'Electronics': 'https://images.unsplash.com/photo-1498049794561-7780e7231661?auto=format&fit=crop&w=400&q=80',
    'Beauty': 'https://images.unsplash.com/photo-1522335789203-aabd1fc54bc9?auto=format&fit=crop&w=400&q=80',
    'Home': 'https://images.unsplash.com/photo-1484101403633-562f891dc89a?auto=format&fit=crop&w=400&q=80',
    'Travel': 'https://images.unsplash.com/photo-1476514525535-07fb3b4ae5f1?auto=format&fit=crop&w=400&q=80',
    'Food': 'https://images.unsplash.com/photo-1504674900247-0877df9cc836?auto=format&fit=crop&w=400&q=80'
  };

  function initCategories(stores) {
    const grid = document.getElementById('sbc-grid-' + SEC_ID);
    if (!grid) return;

    // Count categories
    const counts = {};
    stores.forEach(s => {
      s.categories.forEach(c => {
        counts[c] = (counts[c] || 0) + 1;
      });
    });

    // If manual blocks exist, just update counts
    const manualCards = grid.querySelectorAll('.sbc-card--manual');
    if (manualCards.length > 0) {
      manualCards.forEach(card => {
        const countEl = card.querySelector('.sbc-count');
        if (countEl) {
          const cat = countEl.getAttribute('data-category');
          if (cat && counts[cat]) {
            countEl.textContent = counts[cat] + ' Stores';
          }
        }
      });
      return;
    }

    // Otherwise, generate dynamic cards
    const categories = Object.keys(counts).sort((a,b) => counts[b] - counts[a]).slice(0, 12);
    const fragment = document.createDocumentFragment();

    categories.forEach(cat => {
      const card = document.createElement('a');
      card.className = 'sbc-card';
      card.href = `/?view=stores&cat=${encodeURIComponent(cat)}`;
      
      const imgWrapper = document.createElement('div');
      imgWrapper.className = 'sbc-image-wrapper';
      
      const img = document.createElement('img');
      img.className = 'sbc-image';
      
      // Prioritize Shopify Collection Image, then local fallback, then placeholder
      const shopifyImg = COLLECTION_IMAGES[cat];
      const fallbackImg = FALLBACK_IMAGES[cat];
      img.src = shopifyImg || fallbackImg || `https://images.unsplash.com/photo-1523275335684-37898b6baf30?auto=format&fit=crop&w=400&q=80`;
      
      img.alt = cat;
      img.loading = 'lazy';
      
      const overlay = document.createElement('div');
      overlay.className = 'sbc-overlay';
      
      imgWrapper.appendChild(img);
      imgWrapper.appendChild(overlay);

      const content = document.createElement('div');
      content.className = 'sbc-content';

      const title = document.createElement('span');
      title.className = 'sbc-title';
      title.textContent = cat;

      content.appendChild(title);

      if (SHOW_COUNTS) {
        const count = document.createElement('span');
        count.className = 'sbc-count';
        count.textContent = (counts[cat] || 0) + ' Stores';
        content.appendChild(count);
      }

      card.appendChild(imgWrapper);
      card.appendChild(content);
      fragment.appendChild(card);
    });

    grid.appendChild(fragment);
  }

  function waitForData() {
    if (window.STORES_DATA) {
      initCategories(window.STORES_DATA);
    } else {
      setTimeout(waitForData, 100);
    }
  }

  waitForData();
})();
</script>

{% schema %}
{
  "name": "Shop by Category",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Category"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Browse stores by your favorite categories"
    },
    {
      "type": "checkbox",
      "id": "show_counts",
      "label": "Show Store Counts",
      "default": true
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#fc2779"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "pad_top",
      "label": "Padding Top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 60
    },
    {
      "type": "range",
      "id": "pad_bot",
      "label": "Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by Category",
      "category": "Promotions",
      "blocks": []
    }
  ]
}
{% endschema %}
