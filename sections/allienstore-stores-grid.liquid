<section class="section-allien" style="padding-top:24px;">
  <div class="section-inner-allien">
    <div class="section-header-allien">
      <div>
        <div class="section-label-allien">{{ section.settings.label }}</div>
        <div class="section-title-allien">{{ section.settings.title }}</div>
      </div>
      {%- if section.settings.see_all_link != blank -%}
        <a href="{{ section.settings.see_all_link }}" class="see-all-link-allien">{{ section.settings.see_all_text }}</a>
      {%- endif -%}
    </div>
    <div class="stores-grid-allien">
      {%- for block in section.blocks -%}
        <div class="store-card-allien">
          <div class="store-card-img-allien">
            {%- if block.settings.logo != blank -%}
              <img src="{{ block.settings.logo | image_url: width: 200 }}" alt="{{ block.settings.name }}">
            {%- else -%}
              {{ 'image' | placeholder_svg_tag }}
            {%- endif -%}
          </div>
          <div class="store-card-body-allien">
            <div class="store-cashback-allien">
              <svg width="10" height="10" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2L1 21h22L12 2z"/></svg>
              {{ block.settings.cashback }}
            </div>
            <div class="store-card-name-allien">{{ block.settings.name }}</div>
            <div class="store-card-desc-allien">{{ block.settings.description }}</div>
            <div class="store-card-footer-allien">
              <span class="store-tag-allien">{{ block.settings.tag }}</span>
              <a href="{{ block.settings.url }}" class="store-shop-btn-allien">Shop Now</a>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Allien Stores Grid",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Partner Stores"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "400+ Brands, One Platform"
    },
    {
      "type": "text",
      "id": "see_all_text",
      "label": "See All Text",
      "default": "View All Stores →"
    },
    {
      "type": "url",
      "id": "see_all_link",
      "label": "See All Link"
    }
  ],
  "blocks": [
    {
      "type": "store",
      "name": "Store",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Store Logo"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Store Name"
        },
        {
          "type": "text",
          "id": "cashback",
          "label": "Cashback Text",
          "default": "8.5% Cashback"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Tag",
          "default": "Verified"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Store URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Allien Stores Grid",
      "blocks": [
        { "type": "store", "settings": { "name": "Myntra", "cashback": "9% Cashback", "tag": "Verified" } },
        { "type": "store", "settings": { "name": "Ajio", "cashback": "10% Cashback", "tag": "Top Store" } },
        { "type": "store", "settings": { "name": "Nykaa", "cashback": "7% Cashback", "tag": "Verified" } }
      ]
    }
  ]
}
{% endschema %}
