<footer class="footer-allien">
  <div class="footer-top-allien">
    <div class="footer-col-allien">
      <div class="footer-brand-allien">
        {%- assign name_parts = shop.name | split: ' ' -%}
        {%- if name_parts.size > 1 -%}
          {{ name_parts.first }}<span class="footer-brand-dot-allien">{{ name_parts.last }}</span>
        {%- else -%}
          {%- assign downcase_name = shop.name | downcase -%}
          {%- if downcase_name contains 'store' -%}
            {%- assign name_base = shop.name | replace_first: 'Store', '' | replace_first: 'store', '' -%}
            {{ name_base }}<span class="footer-brand-dot-allien">{% if shop.name contains 'Store' %}Store{% else %}store{% endif %}</span>
          {%- else -%}
            {{ shop.name }}
          {%- endif -%}
        {%- endif -%}
      </div>
      <p class="footer-desc-allien">{{ section.settings.description }}</p>
      <div class="footer-socials-allien">
        {%- if section.settings.facebook_link != blank -%}
          <a href="{{ section.settings.facebook_link }}" class="social-btn-allien" title="Facebook">
            <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.84 3.44 8.87 8 9.8V15H8v-3h2V9.5C10 7.57 11.57 6 13.5 6H16v3h-2c-.55 0-1 .45-1 1v2h3v3h-3v6.8c4.56-.93 8-4.96 8-9.8z"/></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.instagram_link != blank -%}
          <a href="{{ section.settings.instagram_link }}" class="social-btn-allien" title="Instagram">
            <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 1.366.062 2.633.332 3.608 1.308.975.975 1.245 2.242 1.308 3.608.058 1.266.07 1.646.07 4.85s-.012 3.584-.07 4.85c-.063 1.366-.333 2.633-1.308 3.608-.975.975-2.242 1.245-3.608 1.308-1.266.058-1.646.07-4.85.07s-3.584-.012-4.85-.07c-1.366-.063-2.633-.333-3.608-1.308-.975-.975-1.245-2.242-1.308-3.608-.058-1.266-.07-1.646-.07-4.85s.012-3.584.07-4.85c.062-1.366.332-2.633 1.308-3.608.975-.975 2.242-1.245 3.608-1.308 1.266-.058 1.646-.07 4.85-.07M12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.051.014 8.333 0 8.741 0 12s.014 3.667.072 4.947c.2 4.358 2.618 6.78 6.978 6.978 1.28.058 1.688.072 4.947.072s3.667-.014 4.947-.072c4.351-.2 6.77-2.618 6.97-6.978.058-1.28.072-1.688.072-4.947s-.014-3.667-.072-4.947c-.2-4.349-2.617-6.78-6.979-6.98C15.667.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.play_store_link != blank -%}
          <a href="{{ section.settings.play_store_link }}" class="social-btn-allien" title="Google Play Store">
            <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M3 20.5v-17l14.5 8.5L3 20.5zM5 18l10.5-6L5 6v12z"/></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.email_address != blank -%}
          <a href="mailto:{{ section.settings.email_address }}" class="social-btn-allien" title="Email Us">
            <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
          </a>
        {%- endif -%}
      </div>
    </div>
    {%- for block in section.blocks -%}
      {%- if block.type == 'link_list' -%}
        <div class="footer-col-allien">
          <h4>{{ block.settings.title }}</h4>
          <div class="footer-links-allien">
            {%- for link in block.settings.menu.links -%}
              <a href="{{ link.url }}">{{ link.title }}</a>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
  <div class="footer-bottom-allien">
    <div>&copy; {{ 'now' | date: "%Y" }} {{ shop.name }}. All rights reserved.</div>
    <div style="display:flex;gap:16px;">
      {%- for link in section.settings.bottom_menu.links -%}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {%- endfor -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Allien Footer",
  "settings": [
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "India's most trusted cashback and rewards platform. Save on every purchase across 400+ partner brands."
    },
    {
      "type": "url",
      "id": "facebook_link",
      "label": "Facebook Link"
    },
    {
      "type": "url",
      "id": "twitter_link",
      "label": "Twitter Link"
    },
    {
      "type": "url",
      "id": "instagram_link",
      "label": "Instagram Link"
    },
    {
      "type": "url",
      "id": "play_store_link",
      "label": "Play Store Link"
    },
    {
      "type": "text",
      "id": "email_address",
      "label": "Email Address",
      "default": "alliengalaxy071@gmail.com"
    },
    {
      "type": "link_list",
      "id": "bottom_menu",
      "label": "Bottom Menu"
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Menu Column",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Allien Footer"
    }
  ]
}
{% endschema %}
